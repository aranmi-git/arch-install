# arch-install preset v1
# name: i3-cachyos
# id: i3-cachyos@3510e5580817ad80
# Made by arch-install.sh 1.0 on 2026-11-18.
# Load it with:  bash arch-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
FS=btrfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SECUREBOOT=0
SNAPPER=1
SWAP=zram
SWAP_SIZE=4
KERNELS=linux linux-lts
MIRROR=auto
HOST_NAME=archlinux
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=i3
DM=lightdm
DOTS=cachyos-i3
GPU=auto
APPS=firefox mpv git htop neovim
GAMING=
PERIPH=
EXTRA_PKGS=
AUR_HELPER=paru
AUR_PKGS=
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
