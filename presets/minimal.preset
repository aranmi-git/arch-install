# arch-install preset v1
# name: minimal
# id: minimal@007f60d1dd06aa5f
# Made by arch-install.sh 1.0 on 2026-11-18.
# Load it with:  bash arch-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
FS=ext4
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SECUREBOOT=0
SNAPPER=0
SWAP=zram
SWAP_SIZE=4
KERNELS=linux-lts linux
MIRROR=auto
HOST_NAME=arch-server
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=networkd
DESKTOP=none
DM=auto
DOTS=
GPU=auto
APPS=git htop neovim
GAMING=
PERIPH=
EXTRA_PKGS=openssh
AUR_HELPER=none
AUR_PKGS=
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
