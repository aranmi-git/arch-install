# arch-install preset v1
# name: gaming-kde
# id: gaming-kde@190f075a2dd56ce0
# Made by arch-install.sh 1.0 on 2026-11-18.
# Load it with:  bash arch-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
FS=btrfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SECUREBOOT=0
SNAPPER=1
SWAP=zram
SWAP_SIZE=4
KERNELS=linux-zen linux-lts
MIRROR=auto
HOST_NAME=archlinux
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=plasma
DM=sddm
DOTS=
GPU=auto
APPS=firefox discord obs mpv flatpak git
GAMING=multilib steam wine winetricks lutris gamemode
PERIPH=controllers
EXTRA_PKGS=
AUR_HELPER=yay
AUR_PKGS=
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
